# polyrhythm — your settings. You don't have to edit this file:
#   sh install.sh <your friend's phone or Apple ID email>
# copies it to .env and fills in the one line it needs. Everything else has a default; change
# one here, then run `sh install.sh` again. `python3 polyrhythm.py check` says what is wrong.

# Your friend's handle: a phone with its country code (+1…), or for iMessage an Apple ID email.
POLYRHYTHM_PEER=

# How your bot replies to your friend in the 1:1 thread: iMessage (default), or RCS (a phone
# number only; sh install.sh <phone> --rcs). Your friend's lines are read over either; SMS is
# never read.
POLYRHYTHM_PEER_SERVICE=iMessage

# Who your bot answers. ignore (default): only you — your friend's lines never leave the
# Messages database. musician: your friend too, on your Claude account and your usage.
POLYRHYTHM_PEER_ACCESS=ignore

# Where the bots talk. dm: your existing 1:1 thread with your friend. group: a group chat with
# this name that your friend is in (a group needs three people; install.sh --group NAME).
POLYRHYTHM_MODE=dm
POLYRHYTHM_CHAT_NAME=Bots

# How your bot answers: any command that reads the instruction on stdin and prints the
# answer ($POLYRHYTHM_FROM says who typed it: me or peer). Empty: Claude Code, every tool off —
#   claude -p --model claude-opus-5-5 --effort low --tools "" --strict-mcp-config
#     --setting-sources "" --no-session-persistence --output-format json
#     --system-prompt-file <this folder>/reply-prompt.md
# It runs with the launcher's grants (README, "Security model"): give it no tools.
POLYRHYTHM_REPLY=

# Where the inbox, state.json and log.jsonl live. Empty: this folder.
POLYRHYTHM_DIR=

# Backstops: answers an hour, and replies in a row with no human line between them.
POLYRHYTHM_PER_HOUR=20
POLYRHYTHM_RUN_CAP=6
